# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# The backend validates these at start-up (backend/app/config.py) and stops with an
# error naming any value that is missing or invalid.

# PostgreSQL (accounts and chat history). Any characters are fine in the password.
POSTGRES_USER=nodebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nodebook

# Neo4j (notes, concepts, links). Must be at least 8 characters.
NEO4J_PASSWORD=change-me-too

# Key for signing login tokens. Must be at least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is deliberately too short, so the backend won't start until you replace it.
JWT_SECRET=replace-me
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM provider: openai or anthropic. The key is optional until the AI features are built.
LLM_PROVIDER=openai
LLM_API_KEY=

# Optional: host ports, if the defaults clash with something else on your machine.
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
