# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# PostgreSQL (accounts and chat history)
POSTGRES_USER=nodebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nodebook

# Neo4j (notes, concepts, links). Must be at least 8 characters.
NEO4J_PASSWORD=change-me-too

# Optional: host ports, if the defaults clash with something else on your machine.
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
